  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.2.14",
    "expo-module-scripts": "^56.0.3",
    "expo": "^57.0.9",
    "react-native": "0.86.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
