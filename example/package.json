{
  "name": "rn-pos-android-integration-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node ./scripts/link-local-module.js",
    "link-module": "node ./scripts/link-local-module.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:local:release": "eas build --platform android --profile production --local",
    "build:local:debug": "eas build --platform android --profile development --local",
    "update": "eas update --branch production --environment production",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/uuid": "^11.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native": "$react-native",
    "react": "$react",
    "uuid": "$uuid",
    "glob@^13.0.0": "^14.0.3",
    "minimatch@^10.0.0": "^11.0.4"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
