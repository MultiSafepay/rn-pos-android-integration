{
  "name": "rn-pos-android-integration-example",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "node ./scripts/link-local-module.js",
    "link-module": "node ./scripts/link-local-module.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:local:release": "eas build --platform android --profile production --local",
    "build:local:debug": "eas build --platform android --profile development --local",
    "update": "eas update --branch production --environment production",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "^57.0.9",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "@types/uuid": "^11.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-native": "$react-native",
    "react": "$react",
    "uuid": "$uuid"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": ".."
    }
  }
}
